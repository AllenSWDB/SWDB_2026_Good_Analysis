#!/usr/bin/env bash
set -ex

# Solutions notebooks import shared helpers with `from utils import ...`; utils.py lives in
# /code, so make sure it's importable regardless of each notebook's own directory.
export PYTHONPATH="/code:${PYTHONPATH}"

for notebook in /code/Workshop-1_SimulatedAnalysis/solutions/*.ipynb; do
    jupyter nbconvert --to notebook --execute "$notebook" --inplace
done

for notebook in /code/solutions/*.ipynb; do
    jupyter nbconvert --to notebook --execute "$notebook" --inplace
done